# ─────────────────────────────────────────────────────────────────────────────
# Money Path — variables de entorno (Etapa 27 — producción)
#
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` al
# repositorio: está cubierto por `.gitignore` desde la Etapa 23.
#
# Regla: ningún secret vive en el código. Todo valor sensible se lee con
# `process.env.NOMBRE` solo en el servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatorias ─────────────────────────────────────────────────────────────
# Cadena de conexión a PostgreSQL. En producción usar TLS y credenciales
# dedicadas de un gestor (no el usuario `postgres` de desarrollo).
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_base

# ── Autenticación ────────────────────────────────────────────────────────────
# Secreto de Better Auth (mínimo 32 caracteres). Si no existe, la aplicación
# genera y persiste uno en `app_settings.auth.secret` — funciona, pero en
# producción conviene fijarlo para que las sesiones sobrevivan a un rebuild.
BETTER_AUTH_SECRET=

# URL pública canónica del sitio (usada por Better Auth para los orígenes).
BETTER_AUTH_URL=https://moneypath.mx

# ── Sitio / SEO ──────────────────────────────────────────────────────────────
# URL canónica usada en metadata, robots.txt y sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://moneypath.mx

# ── Correo (opcional) ────────────────────────────────────────────────────────
# Sin estas variables el registro funciona y los enlaces de restablecimiento
# se guardan en la herramienta de preview (deshabilitada si hay API key).
RESEND_API_KEY=
EMAIL_FROM=Money Path <noreply@moneypath.mx>

# ── Herramienta de desarrollo (NO activar en producción) ─────────────────────
# Expone `/api/auth/dev/reset-link`. Debe permanecer vacío o distinto de
# "true" en producción; además queda deshabilitada si hay RESEND_API_KEY.
NEXT_PUBLIC_AUTH_DEV_RESET=

# ── Pagos (deshabilitados hasta configurarlos) ───────────────────────────────
# Mientras `PAYMENTS_PROVIDER` esté vacío, el checkout responde
# GATEWAY_NOT_CONFIGURED y el plan sigue en Free. No existe forma de activar
# Pro sin un pago verificado por webhook firmado.
PAYMENTS_PROVIDER=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_API_KEY=
